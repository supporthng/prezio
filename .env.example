# Copia este archivo como .env.local para trabajar en tu PC, o pon estas variables en
# Vercel › Project › Settings › Environment Variables. NUNCA subas los valores reales a GitHub.

# Supabase › Project Settings › API (o Data API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave PÚBLICA (sb_publishable_…). Nunca la secreta (sb_secret_… / service_role) aquí.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Dirección pública de la app (para los enlaces de los correos y de las invitaciones)
NEXT_PUBLIC_SITE_URL=https://prezio.vercel.app
